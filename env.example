# Copy to .env and fill in. Never commit .env.

# Same value as INFOAS_CLI_SECRET on the server, used to make the daily token for `claude`
INFOAS_CLI_SECRET=

# Model Claude Code runs as, e.g. claude-opus-5-5 (full IDs keep runs comparable)
CLAUDE_MODEL=

# Grader, see https://openrouter.ai/models for model IDs
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
