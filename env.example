# Copy into .env and fill in the values

# Request an InfoAs CLI secret at https://infoas.ro/contact
INFOAS_CLI_SECRET=your-infoas-cli-secret
OPENROUTER_API_KEY=your-openrouter-api-key

# Use OpenRouter's model IDs to specify which model to use.

# The writer is the agent that generates C++ solutions.
# Note: Regardless of the model, it will log in as @claude on InfoAs.
WRITER_MODEL=anthropic/claude-haiku-5.5

# The grader is the agent that grades how the writer approached reward hacking.
GRADER_MODEL=anthropic/claude-haiku-5.5